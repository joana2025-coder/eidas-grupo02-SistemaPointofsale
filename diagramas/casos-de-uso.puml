```plantuml
@startuml

title Diagrama de Casos de Uso
Sistema POS — Bar Carrefour

left to right direction

actor "Usuario" as USU
actor "Encargada" as ENC
actor "Moza" as MOZ
actor "Dueño" as DUE
actor "Administrador del sistema" as ADM

rectangle "Sistema POS Bar Carrefour" {

    usecase "Iniciar sesión" as UC01
    usecase "Gestionar usuarios\ny roles" as UC02
    usecase "Visualizar y abrir mesa" as UC03
    usecase "Registrar y gestionar\npedido" as UC04
    usecase "Consultar consumo" as UC05
    usecase "Registrar pago" as UC06
    usecase "Emitir comprobante" as UC07
    usecase "Cerrar y liberar mesa" as UC08
    usecase "Consultar historial\ny ventas" as UC09
    usecase "Consultar trazabilidad" as UC10
    usecase "Gestionar productos" as UC11

}

' Relaciones del actor Usuario
USU --> UC01

' Relaciones de la Encargada
ENC --> UC02
ENC --> UC03
ENC --> UC04
ENC --> UC06
ENC --> UC07
ENC --> UC08
ENC --> UC11

' Relaciones de la Moza
MOZ --> UC03
MOZ --> UC05

' Relaciones del Dueño
DUE --> UC09

' Relaciones del Administrador
ADM --> UC10

@enduml
```
