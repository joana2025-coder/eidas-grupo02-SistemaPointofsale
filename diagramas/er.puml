@startuml

title Modelo Entidad-Relación - Sistema POS Bar Carrefour

entity Usuario {
    * id_usuario : INT <<PK>>
    --
    nombre : VARCHAR
    usuario : VARCHAR
    contraseña : VARCHAR
    rol : VARCHAR
    activo : BOOLEAN
}

entity Mesa {
    * id_mesa : INT <<PK>>
    --
    numero_mesa : INT
    estado : VARCHAR
}

entity Cuenta {
    * id_cuenta : INT <<PK>>
    --
    fecha_apertura : DATETIME
    fecha_cierre : DATETIME
    estado : VARCHAR
    id_mesa : INT <<FK>>
}

entity Pedido {
    * id_pedido : INT <<PK>>
    --
    fecha : DATETIME
    subtotal : DECIMAL
    id_cuenta : INT <<FK>>
    id_usuario : INT <<FK>>
}

entity Detalle_Pedido {
    * id_detalle : INT <<PK>>
    --
    cantidad : INT
    precio_unitario : DECIMAL
    subtotal : DECIMAL
    id_pedido : INT <<FK>>
    id_producto : INT <<FK>>
}

entity Producto {
    * id_producto : INT <<PK>>
    --
    nombre : VARCHAR
    precio : DECIMAL
    categoria : VARCHAR
    activo : BOOLEAN
}

entity Pago {
    * id_pago : INT <<PK>>
    --
    metodo_pago : VARCHAR
    total : DECIMAL
    fecha : DATETIME
    id_cuenta : INT <<FK>>
}

entity Ticket {
    * id_ticket : INT <<PK>>
    --
    fecha_emision : DATETIME
    id_pago : INT <<FK, UNIQUE>>
}

entity Trazabilidad {
    * id_trazabilidad : INT <<PK>>
    --
    accion : VARCHAR
    fecha_hora : DATETIME
    id_usuario : INT <<FK>>
    id_mesa : INT <<FK, NULL>>
    entidad_afectada : VARCHAR
    id_registro_afectado : INT
}

Mesa ||--o{ Cuenta : registra ocupaciones
Cuenta ||--o{ Pedido : agrupa
Usuario ||--o{ Pedido : registra
Pedido ||--|{ Detalle_Pedido : contiene
Producto ||--o{ Detalle_Pedido : corresponde
Cuenta ||--o| Pago : recibe
Pago ||--|| Ticket : emite
Usuario ||--o{ Trazabilidad : realiza
Mesa ||--o{ Trazabilidad : se asocia

@enduml
